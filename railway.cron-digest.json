{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c 'cd backend && python jobs.py weekly-digest'",
    "cronSchedule": "0 13 * * 1",
    "restartPolicyType": "NEVER"
  }
}
